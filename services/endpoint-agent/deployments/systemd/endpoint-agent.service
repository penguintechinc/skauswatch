[Unit]
Description=SkausWatch ENDPOINT Agent
Documentation=https://github.com/penguintech/skauswatch
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root

# Environment file for configuration
EnvironmentFile=-/etc/skauswatch/endpoint-agent.env

# Main executable
ExecStart=/usr/local/bin/endpoint-agent --config /etc/skauswatch/endpoint-agent.yaml

# Restart policy
Restart=always
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=endpoint-agent

# Security hardening (comment out if causing issues)
NoNewPrivileges=false
ProtectSystem=false
ProtectHome=false
PrivateTmp=false

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
