# Flask Configuration
# Environment mode: development or production
FLASK_ENV=development

# Enable Flask debug mode (disable in production)
FLASK_DEBUG=true

# Secret key for session management (change in production)
SECRET_KEY=change-me-in-production

# Port for worker-scanner Flask service
WORKER_SCANNER_PORT=5001


# JWT Authentication
# Shared secret key with flask-backend for token validation
JWT_SECRET_KEY=change-me-shared-secret

# JWT algorithm for token signing/verification
JWT_ALGORITHM=HS256


# Database Configuration (PyDAL)
# Database type: postgres, mysql, mariadb, or sqlite
DB_TYPE=postgres

# Database host
DB_HOST=postgres

# Database port
DB_PORT=5432

# Database name
DB_NAME=skauswatch

# Database user
DB_USER=skauswatch

# Database password (change in production)
DB_PASSWORD=changeme


# Redis Configuration (Celery broker)
# Redis connection URL for Celery message broker
REDIS_URL=redis://redis:6379/0

# Celery broker URL (can differ from REDIS_URL if using different Redis instance)
CELERY_BROKER_URL=redis://redis:6379/0

# Celery result backend for storing task results
CELERY_RESULT_BACKEND=redis://redis:6379/1


# Scanner Enable/Disable Flags
# Enable/disable Nuclei scanner
SCANNER_NUCLEI_ENABLED=true

# Enable/disable OWASP ZAP scanner
SCANNER_ZAP_ENABLED=true

# Enable/disable OpenVAS scanner
SCANNER_OPENVAS_ENABLED=true


# OWASP ZAP Scanner Configuration
# ZAP service URL
SCANNER_ZAP_URL=http://zap:8080

# ZAP API key for authentication (obtain from ZAP instance)
SCANNER_ZAP_API_KEY=


# OpenVAS Scanner Configuration
# OpenVAS host/service name
SCANNER_OPENVAS_HOST=openvas

# OpenVAS port
SCANNER_OPENVAS_PORT=9390

# OpenVAS admin username
SCANNER_OPENVAS_USER=admin

# OpenVAS admin password (change in production)
SCANNER_OPENVAS_PASSWORD=changeme


# Docker Compose Scaling
# Scale factor for ZAP container (0 to disable)
SCANNER_ZAP_SCALE=1

# Scale factor for OpenVAS container (0 to disable)
SCANNER_OPENVAS_SCALE=1


# Nuclei Scanner Configuration
# Path to nuclei binary executable
NUCLEI_BINARY_PATH=/usr/local/bin/nuclei

# Path to nuclei templates directory
NUCLEI_TEMPLATES_PATH=/root/nuclei-templates

# Request rate limit for Nuclei scans
NUCLEI_RATE_LIMIT=150

# Concurrency level for Nuclei scanning
NUCLEI_CONCURRENCY=25


# Logging Configuration
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: json or text
LOG_FORMAT=json


# License Configuration (Optional)
# License key for feature gating (format: PENG-XXXX-XXXX-XXXX-XXXX-ABCD)
LICENSE_KEY=

# License server URL for validation
LICENSE_SERVER_URL=https://license.penguintech.io

# Product name for license identification
PRODUCT_NAME=skauswatch

# Release mode: false (development - all features), true (production - license enforced)
RELEASE_MODE=false
