# SkausWatch Test Environment Configuration
# Copy this file to .env.test for running tests

# =============================================================================
# TEST ENVIRONMENT SETTINGS
# =============================================================================

# Environment
NODE_ENV=test
GO_ENV=test
DEBUG=false
LOG_LEVEL=warn

# Application Version
SKAUSWATCH_VERSION=test

# =============================================================================
# TEST DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL - Test Database (separate from dev)
POSTGRES_DB=skauswatch_test
POSTGRES_USER=skauswatch_test
POSTGRES_PASSWORD=testpassword
POSTGRES_PORT=5433
POSTGRES_HOST=localhost
DATABASE_URL=postgres://skauswatch_test:testpassword@localhost:5433/skauswatch_test

# =============================================================================
# TEST CACHE AND SESSIONS
# =============================================================================

# Redis - Test Instance (separate database)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1  # Different database for tests
REDIS_URL=redis://localhost:6379/1

# =============================================================================
# TEST MESSAGE QUEUE
# =============================================================================

# RabbitMQ - Test vhost
RABBITMQ_USER=test
RABBITMQ_PASSWORD=testpassword
RABBITMQ_VHOST=/test
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_URL=amqp://test:testpassword@localhost:5672/test

# =============================================================================
# TEST OBJECT STORAGE
# =============================================================================

# MinIO - Test Buckets
MINIO_ROOT_USER=testuser
MINIO_ROOT_PASSWORD=testpassword123
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost:9000
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=skauswatch-test

# =============================================================================
# TEST SEARCH AND LOGGING
# =============================================================================

# Elasticsearch - Test Index
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_TRANSPORT_PORT=9300
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=test_

# =============================================================================
# TEST APPLICATION SERVICES
# =============================================================================

# Service Ports - Test Ports (offset by 1000 from dev)
MANAGER_PORT=9080
PKI_SERVER_PORT=9081
SSH_CA_PORT=9082
AAA_MONITOR_PORT=9083
WEB_PORTAL_PORT=4000

# Service URLs - Test Environment
MANAGER_URL=http://localhost:9080
PKI_SERVER_URL=http://localhost:9081
SSH_CA_URL=http://localhost:9082
AAA_MONITOR_URL=http://localhost:9083

# =============================================================================
# TEST WEB PORTAL
# =============================================================================

# Next.js - Test Configuration
NEXT_PUBLIC_API_URL=http://localhost:9080
NEXT_PUBLIC_PKI_URL=http://localhost:9081
NEXT_PUBLIC_SSH_CA_URL=http://localhost:9082
NEXT_PUBLIC_AAA_URL=http://localhost:9083
NEXT_TELEMETRY_DISABLED=1

# =============================================================================
# TEST SECURITY CONFIGURATION
# =============================================================================

# JWT - Test Keys (Short expiration)
JWT_SECRET=test-secret-key-for-testing-only-not-secure-just-for-tests
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=2h

# Encryption - Test Key
ENCRYPTION_KEY=test-encryption-key-32-characters

# SSL/TLS - Test Certificates
TLS_CERT_PATH=./config/ssl/test/cert.pem
TLS_KEY_PATH=./config/ssl/test/key.pem
TLS_CA_PATH=./config/ssl/test/ca.pem

# =============================================================================
# TEST PKI CONFIGURATION
# =============================================================================

# CA Settings - Test CA
CA_ROOT_PATH=/tmp/test/ca/root
CA_INTERMEDIATE_PATH=/tmp/test/ca/intermediate
CA_ORGANIZATION="SkausWatch Test"
CA_COUNTRY=US
CA_STATE="Test State"
CA_LOCALITY="Test City"

# HSM - Disabled for tests
HSM_ENABLED=false

# =============================================================================
# TEST SSH CA CONFIGURATION
# =============================================================================

# SSH CA - Test Keys
SSH_CA_KEY_PATH=/tmp/test/ssh-ca/test_ca_key
SSH_CA_CERT_PATH=/tmp/test/ssh-ca/test_ca_cert.pub
SSH_CERT_VALIDITY_DURATION=1h
SSH_MAX_CERT_LIFETIME=1d

# =============================================================================
# TEST AUTHENTICATION
# =============================================================================

# LDAP - Disabled for tests
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
LDAP_USER_FILTER=
LDAP_GROUP_FILTER=

# OAuth2 - Disabled for tests
OAUTH2_ENABLED=false

# SAML - Disabled for tests
SAML_ENABLED=false

# =============================================================================
# TEST EMAIL CONFIGURATION
# =============================================================================

# SMTP - Test with mock SMTP server
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=test@skauswatch.test
SMTP_TLS=false

# =============================================================================
# TEST PERFORMANCE SETTINGS
# =============================================================================

# Database - Minimal connections for tests
DB_MAX_CONNECTIONS=5
DB_MIN_CONNECTIONS=1
DB_CONNECTION_TIMEOUT=5s

# Cache - Fast TTL for tests
CACHE_TTL=60  # 1 minute
CACHE_MAX_SIZE=50

# Rate Limiting - Disabled for tests
RATE_LIMIT_ENABLED=false

# =============================================================================
# TEST LOGGING CONFIGURATION
# =============================================================================

# Minimal logging for tests (unless debugging)
LOG_FORMAT=json
LOG_OUTPUT=stdout
LOG_LEVEL=warn

# Component logging - Minimal for tests
MANAGER_LOG_LEVEL=warn
PKI_SERVER_LOG_LEVEL=warn
SSH_CA_LOG_LEVEL=warn
AAA_MONITOR_LOG_LEVEL=warn
WEB_PORTAL_LOG_LEVEL=warn

# Test-specific logging
TEST_LOG_LEVEL=info
TEST_OUTPUT_VERBOSE=false

# =============================================================================
# TEST FEATURE FLAGS
# =============================================================================

# Features - Optimized for testing
FEATURE_AUTO_RENEWAL=false  # Disabled to prevent interference
FEATURE_CERTIFICATE_TRANSPARENCY=false
FEATURE_OCSP_RESPONDER=false
FEATURE_CRL_DISTRIBUTION=false
FEATURE_KEY_ESCROW=false
FEATURE_MULTI_TENANCY=false

# =============================================================================
# TEST SPECIFIC SETTINGS
# =============================================================================

# Test Behavior
TEST_TIMEOUT=30s
TEST_PARALLEL=true
TEST_COVERAGE=true
TEST_RACE_DETECTION=true

# Integration Test Settings
INTEGRATION_TEST_ENABLED=true
INTEGRATION_TEST_TIMEOUT=60s
INTEGRATION_TEST_CLEANUP=true

# E2E Test Settings
E2E_TEST_ENABLED=true
E2E_TEST_BROWSER=chromium
E2E_TEST_HEADLESS=true
E2E_TEST_TIMEOUT=120s

# Load Test Settings
LOAD_TEST_ENABLED=false
LOAD_TEST_CONCURRENT_USERS=10
LOAD_TEST_DURATION=30s

# =============================================================================
# TEST WEBHOOKS AND EXTERNAL SERVICES
# =============================================================================

# Webhooks - Fast timeouts for tests
WEBHOOK_ENABLED=true
WEBHOOK_TIMEOUT=5s
WEBHOOK_RETRY_COUNT=0  # No retries in tests

# Certificate Validation - Relaxed for tests
CERT_VALIDATION_STRICT=false
CERT_VALIDATION_CRL_CHECK=false
CERT_VALIDATION_OCSP_CHECK=false

# Key Management - Disabled for tests
KEY_ROTATION_ENABLED=false
KEY_BACKUP_ENABLED=false

# Audit - Minimal for tests
AUDIT_LOG_ENABLED=true
AUDIT_LOG_LEVEL=warn
AUDIT_LOG_FORMAT=json
AUDIT_LOG_RETENTION_DAYS=1

# Backup - Disabled for tests
BACKUP_ENABLED=false

# =============================================================================
# MOCK SERVICES FOR TESTING
# =============================================================================

# Mock HSM
MOCK_HSM_ENABLED=true
MOCK_HSM_RESPONSES=success

# Mock LDAP
MOCK_LDAP_ENABLED=true
MOCK_LDAP_USERS=testuser1,testuser2,admin

# Mock External APIs
MOCK_EXTERNAL_APIs=true
MOCK_API_LATENCY=0

# Test Data Fixtures
FIXTURE_DATA_PATH=./test/fixtures
FIXTURE_AUTO_LOAD=true

# =============================================================================
# CI/CD SPECIFIC SETTINGS
# =============================================================================

# CI Environment Detection
CI=false  # Set to true in CI environments
CI_TIMEOUT_MULTIPLIER=2

# Test Reporting
TEST_REPORT_FORMAT=junit
TEST_REPORT_PATH=./test-reports
TEST_COVERAGE_FORMAT=lcov
TEST_COVERAGE_PATH=./coverage

# Artifact Settings
TEST_ARTIFACT_RETENTION=7d
TEST_SCREENSHOT_ON_FAILURE=true
TEST_VIDEO_RECORDING=false

# =============================================================================
# DATABASE TESTING
# =============================================================================

# Test Database Management
TEST_DB_RESET_BEFORE_SUITE=true
TEST_DB_RESET_BEFORE_TEST=false
TEST_DB_SEED_DATA=true
TEST_DB_MIGRATION_TEST=true

# Transaction Isolation
TEST_DB_TRANSACTION_ISOLATION=true
TEST_DB_ROLLBACK_ON_FAILURE=true

# =============================================================================
# PERFORMANCE TESTING
# =============================================================================

# Performance Test Thresholds
PERF_TEST_MAX_RESPONSE_TIME=1000ms
PERF_TEST_MAX_CPU_USAGE=80
PERF_TEST_MAX_MEMORY_USAGE=512MB

# Load Test Scenarios
LOAD_TEST_SCENARIOS=basic,certificate_creation,user_authentication
LOAD_TEST_RAMP_UP_TIME=10s
LOAD_TEST_STEADY_TIME=60s

# =============================================================================
# TEST ENVIRONMENT NOTES
# =============================================================================

# This configuration is optimized for testing:
# - Uses separate test databases and services
# - Shorter timeouts and TTLs for faster test execution
# - Disabled features that could interfere with tests
# - Enhanced logging for test debugging
# - Mock services for external dependencies
# - Cleanup mechanisms for test isolation

# Test Types Supported:
# - Unit Tests: Individual component testing
# - Integration Tests: Service interaction testing
# - E2E Tests: Full workflow testing
# - Load Tests: Performance and stress testing
# - Security Tests: Vulnerability and compliance testing

# Test Commands:
# - `npm test` - Run unit tests
# - `npm run test:integration` - Run integration tests
# - `npm run test:e2e` - Run end-to-end tests
# - `npm run test:load` - Run load tests
# - `npm run test:all` - Run all tests

# CI/CD Integration:
# - Configured for GitHub Actions, GitLab CI, Jenkins
# - Supports parallel test execution
# - Generates coverage reports and test artifacts
# - Integrates with quality gates and deployment pipelines