# SkausWatch Local Development Environment Configuration
# Copy this file to .env.local for local development

# =============================================================================
# LOCAL DEVELOPMENT SETTINGS
# =============================================================================

# Environment
NODE_ENV=development
GO_ENV=development
DEBUG=true
LOG_LEVEL=debug

# Application Version
SKAUSWATCH_VERSION=dev

# =============================================================================
# DATABASE - LOCAL DEVELOPMENT
# =============================================================================

# PostgreSQL - Local Development Database
POSTGRES_DB=skauswatch_dev
POSTGRES_USER=skauswatch_dev
POSTGRES_PASSWORD=devpassword
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
DATABASE_URL=postgres://skauswatch_dev:devpassword@localhost:5432/skauswatch_dev

# =============================================================================
# CACHE AND SESSIONS - LOCAL
# =============================================================================

# Redis - Local Development
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# =============================================================================
# MESSAGE QUEUE - LOCAL
# =============================================================================

# RabbitMQ - Local Development
RABBITMQ_USER=dev
RABBITMQ_PASSWORD=devpassword
RABBITMQ_VHOST=/
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_URL=amqp://dev:devpassword@localhost:5672/

# =============================================================================
# OBJECT STORAGE - LOCAL
# =============================================================================

# MinIO - Local Development
MINIO_ROOT_USER=devuser
MINIO_ROOT_PASSWORD=devpassword123
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost:9000
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=skauswatch-dev

# =============================================================================
# SEARCH AND LOGGING - LOCAL
# =============================================================================

# Elasticsearch - Local Development
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_TRANSPORT_PORT=9300
ELASTICSEARCH_URL=http://localhost:9200

# =============================================================================
# MONITORING - LOCAL
# =============================================================================

# Prometheus - Local Development
PROMETHEUS_HOST=localhost
PROMETHEUS_PORT=9090
PROMETHEUS_URL=http://localhost:9090

# Grafana - Local Development
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_HOST=localhost
GRAFANA_PORT=3001
GRAFANA_URL=http://localhost:3001

# =============================================================================
# APPLICATION SERVICES - LOCAL
# =============================================================================

# Service Ports - Local Development
MANAGER_PORT=8080
PKI_SERVER_PORT=8081
SSH_CA_PORT=8082
AAA_MONITOR_PORT=8083
WEB_PORTAL_PORT=3000

# Service URLs - Local Development
MANAGER_URL=http://localhost:8080
PKI_SERVER_URL=http://localhost:8081
SSH_CA_URL=http://localhost:8082
AAA_MONITOR_URL=http://localhost:8083

# =============================================================================
# WEB PORTAL - LOCAL DEVELOPMENT
# =============================================================================

# Next.js - Local Development
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_PKI_URL=http://localhost:8081
NEXT_PUBLIC_SSH_CA_URL=http://localhost:8082
NEXT_PUBLIC_AAA_URL=http://localhost:8083
NEXT_TELEMETRY_DISABLED=1
WATCHPACK_POLLING=true

# =============================================================================
# REVERSE PROXY - LOCAL
# =============================================================================

# Nginx - Local Development
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# =============================================================================
# SECURITY - LOCAL DEVELOPMENT (NOT FOR PRODUCTION)
# =============================================================================

# JWT - Development Keys (INSECURE)
JWT_SECRET=dev-secret-key-change-in-production-super-long-key-for-jwt-signing
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d

# Encryption - Development Key (INSECURE)
ENCRYPTION_KEY=dev-encryption-key-32-characters

# SSL/TLS - Local Development Certificates
TLS_CERT_PATH=./config/ssl/dev/cert.pem
TLS_KEY_PATH=./config/ssl/dev/key.pem
TLS_CA_PATH=./config/ssl/dev/ca.pem

# =============================================================================
# PKI - LOCAL DEVELOPMENT
# =============================================================================

# CA Settings - Local Development
CA_ROOT_PATH=/app/ca/dev/root
CA_INTERMEDIATE_PATH=/app/ca/dev/intermediate
CA_ORGANIZATION="SkausWatch Development"
CA_COUNTRY=US
CA_STATE="Dev State"
CA_LOCALITY="Dev City"

# HSM - Disabled for local development
HSM_ENABLED=false

# =============================================================================
# SSH CA - LOCAL DEVELOPMENT
# =============================================================================

# SSH CA - Local Development
SSH_CA_KEY_PATH=/app/ssh-ca/dev_ca_key
SSH_CA_CERT_PATH=/app/ssh-ca/dev_ca_cert.pub
SSH_CERT_VALIDITY_DURATION=24h
SSH_MAX_CERT_LIFETIME=7d

# =============================================================================
# AUTHENTICATION - LOCAL DEVELOPMENT
# =============================================================================

# LDAP - Disabled for local development
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
LDAP_USER_FILTER=
LDAP_GROUP_FILTER=

# OAuth2 - Disabled for local development
OAUTH2_ENABLED=false
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_REDIRECT_URL=http://localhost:3000/auth/callback
OAUTH2_PROVIDER_URL=

# SAML - Disabled for local development
SAML_ENABLED=false

# =============================================================================
# EMAIL - LOCAL DEVELOPMENT (MAILHOG)
# =============================================================================

# SMTP - Local Development with MailHog
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=dev@skauswatch.local
SMTP_TLS=false

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================

# Development Features
HOT_RELOAD=true
DEV_SERVER_HOST=0.0.0.0
WATCHPACK_POLLING=true

# Debugging
GO_DELVE_ENABLED=true
DELVE_PORT_MANAGER=40000
DELVE_PORT_PKI=40001
DELVE_PORT_SSH_CA=40002
DELVE_PORT_AAA=40003

# =============================================================================
# PERFORMANCE - LOCAL DEVELOPMENT
# =============================================================================

# Database - Reduced settings for local development
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=2
DB_CONNECTION_TIMEOUT=10s

# Cache - Local development settings
CACHE_TTL=300  # 5 minutes
CACHE_MAX_SIZE=100

# Rate Limiting - Relaxed for development
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=1000
RATE_LIMIT_BURST=100

# =============================================================================
# LOGGING - LOCAL DEVELOPMENT
# =============================================================================

# Enhanced logging for development
LOG_FORMAT=text
LOG_OUTPUT=stdout
LOG_LEVEL=debug

# Component-specific debug logging
MANAGER_LOG_LEVEL=debug
PKI_SERVER_LOG_LEVEL=debug
SSH_CA_LOG_LEVEL=debug
AAA_MONITOR_LOG_LEVEL=debug
WEB_PORTAL_LOG_LEVEL=debug

# =============================================================================
# FEATURES - LOCAL DEVELOPMENT
# =============================================================================

# All features enabled for testing
FEATURE_AUTO_RENEWAL=true
FEATURE_CERTIFICATE_TRANSPARENCY=false  # Disabled for dev
FEATURE_OCSP_RESPONDER=true
FEATURE_CRL_DISTRIBUTION=true
FEATURE_KEY_ESCROW=false
FEATURE_MULTI_TENANCY=false

# =============================================================================
# ADVANCED - LOCAL DEVELOPMENT
# =============================================================================

# Webhooks - Local development
WEBHOOK_ENABLED=true
WEBHOOK_TIMEOUT=10s
WEBHOOK_RETRY_COUNT=1

# Certificate Validation - Relaxed for development
CERT_VALIDATION_STRICT=false
CERT_VALIDATION_CRL_CHECK=false
CERT_VALIDATION_OCSP_CHECK=false

# Key Management - Frequent rotation for testing
KEY_ROTATION_ENABLED=false  # Disabled in dev to prevent confusion
KEY_ROTATION_INTERVAL=7d
KEY_BACKUP_ENABLED=true

# Audit - Simplified for development
AUDIT_LOG_ENABLED=true
AUDIT_LOG_LEVEL=debug
AUDIT_LOG_FORMAT=text
AUDIT_LOG_RETENTION_DAYS=7

# Backup - Disabled for local development
BACKUP_ENABLED=false

# =============================================================================
# EXTERNAL SERVICES - LOCAL DEVELOPMENT
# =============================================================================

# Database Administration
ADMINER_PORT=8084

# Redis Management
REDIS_COMMANDER_PORT=8085

# Email Testing
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025

# =============================================================================
# DEVELOPMENT NOTES
# =============================================================================

# This configuration is optimized for local development:
# - Uses insecure passwords and keys (never use in production)
# - Enables debug logging and hot reload
# - Includes development tools (Adminer, Redis Commander, MailHog)
# - Relaxes security settings for easier testing
# - Uses shorter timeouts and smaller limits
# - Disables production-only features like HSM and external auth

# To use this configuration:
# 1. Copy to .env.local
# 2. Run `./scripts/dev-setup.sh` to initialize the development environment
# 3. Start services with `./scripts/dev-start.sh`
# 4. Access the web interface at http://localhost:3000