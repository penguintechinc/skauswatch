# SkausWatch Environment Configuration
# Copy this file to .env and customize the values for your environment

# =============================================================================
# GENERAL CONFIGURATION
# =============================================================================

# Application Environment
NODE_ENV=development
GO_ENV=development
DEBUG=true
LOG_LEVEL=info

# SkausWatch Version
SKAUSWATCH_VERSION=latest

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database
POSTGRES_DB=skauswatch
POSTGRES_USER=skauswatch
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Database URL (automatically constructed if not set)
DATABASE_URL=postgres://skauswatch:changeme_strong_password@localhost:5432/skauswatch

# =============================================================================
# CACHE AND SESSION STORAGE
# =============================================================================

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# =============================================================================
# MESSAGE QUEUE
# =============================================================================

# RabbitMQ Configuration
RABBITMQ_USER=skauswatch
RABBITMQ_PASSWORD=changeme_rabbitmq_password
RABBITMQ_VHOST=/
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_URL=amqp://skauswatch:changeme_rabbitmq_password@localhost:5672/

# =============================================================================
# OBJECT STORAGE
# =============================================================================

# MinIO Configuration
MINIO_ROOT_USER=skauswatch
MINIO_ROOT_PASSWORD=changeme_minio_password_min_8_chars
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost:9000
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=skauswatch-storage

# =============================================================================
# SEARCH AND LOGGING
# =============================================================================

# Elasticsearch Configuration
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_TRANSPORT_PORT=9300
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme_elastic_password

# =============================================================================
# MONITORING AND METRICS
# =============================================================================

# Prometheus Configuration
PROMETHEUS_HOST=localhost
PROMETHEUS_PORT=9090
PROMETHEUS_URL=http://localhost:9090

# Grafana Configuration
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme_grafana_password
GRAFANA_HOST=localhost
GRAFANA_PORT=3001
GRAFANA_URL=http://localhost:3001

# =============================================================================
# APPLICATION SERVICES
# =============================================================================

# Service Ports
MANAGER_PORT=8080
PKI_SERVER_PORT=8081
SSH_CA_PORT=8082
AAA_MONITOR_PORT=8083
WEB_PORTAL_PORT=3000

# Service URLs (for internal communication)
MANAGER_URL=http://localhost:8080
PKI_SERVER_URL=http://localhost:8081
SSH_CA_URL=http://localhost:8082
AAA_MONITOR_URL=http://localhost:8083

# =============================================================================
# WEB PORTAL (FRONTEND) CONFIGURATION
# =============================================================================

# Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_PKI_URL=http://localhost:8081
NEXT_PUBLIC_SSH_CA_URL=http://localhost:8082
NEXT_PUBLIC_AAA_URL=http://localhost:8083
NEXT_TELEMETRY_DISABLED=1

# =============================================================================
# REVERSE PROXY CONFIGURATION
# =============================================================================

# Nginx Configuration
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT Configuration
JWT_SECRET=changeme_jwt_secret_at_least_32_characters_long_for_security
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d

# Encryption Configuration
ENCRYPTION_KEY=changeme_encryption_key_exactly_32_chars
ENCRYPTION_ALGORITHM=AES-256-GCM

# SSL/TLS Configuration
TLS_CERT_PATH=./config/ssl/cert.pem
TLS_KEY_PATH=./config/ssl/key.pem
TLS_CA_PATH=./config/ssl/ca.pem

# =============================================================================
# PKI CONFIGURATION
# =============================================================================

# Certificate Authority Settings
CA_ROOT_PATH=/app/ca/root
CA_INTERMEDIATE_PATH=/app/ca/intermediate
CA_ORGANIZATION="Your Organization"
CA_COUNTRY=US
CA_STATE="Your State"
CA_LOCALITY="Your City"

# HSM Configuration (Hardware Security Module)
HSM_ENABLED=false
HSM_SLOT=0
HSM_PIN=changeme_hsm_pin
HSM_LIBRARY_PATH=/usr/local/lib/libpkcs11.so

# =============================================================================
# SSH CA CONFIGURATION
# =============================================================================

# SSH Certificate Authority
SSH_CA_KEY_PATH=/app/ssh-ca/ca_key
SSH_CA_CERT_PATH=/app/ssh-ca/ca_cert.pub
SSH_CERT_VALIDITY_DURATION=24h
SSH_MAX_CERT_LIFETIME=30d

# =============================================================================
# AUTHENTICATION CONFIGURATION
# =============================================================================

# LDAP/Active Directory Integration
LDAP_URL=ldap://ldap.example.com:389
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=changeme_ldap_password
LDAP_BASE_DN=dc=example,dc=com
LDAP_USER_FILTER=(uid=%s)
LDAP_GROUP_FILTER=(member=%s)

# OAuth2/OIDC Configuration
OAUTH2_ENABLED=false
OAUTH2_CLIENT_ID=your_oauth2_client_id
OAUTH2_CLIENT_SECRET=changeme_oauth2_client_secret
OAUTH2_REDIRECT_URL=http://localhost:3000/auth/callback
OAUTH2_PROVIDER_URL=https://auth.example.com

# SAML Configuration
SAML_ENABLED=false
SAML_SSO_URL=https://sso.example.com/saml/sso
SAML_METADATA_URL=https://sso.example.com/saml/metadata
SAML_CERTIFICATE_PATH=./config/saml/cert.pem

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# SMTP Settings for notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASSWORD=changeme_smtp_password
SMTP_FROM=noreply@example.com
SMTP_TLS=true

# Email Templates
EMAIL_TEMPLATE_PATH=./config/email-templates

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Backup Settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# S3-Compatible Backup Storage
BACKUP_S3_ENDPOINT=s3.amazonaws.com
BACKUP_S3_BUCKET=skauswatch-backups
BACKUP_S3_ACCESS_KEY=changeme_backup_access_key
BACKUP_S3_SECRET_KEY=changeme_backup_secret_key
BACKUP_S3_REGION=us-east-1

# =============================================================================
# COMPLIANCE AND AUDIT
# =============================================================================

# Audit Logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_LEVEL=info
AUDIT_LOG_FORMAT=json
AUDIT_LOG_RETENTION_DAYS=365

# Compliance Settings
COMPLIANCE_MODE=standard
FIPS_MODE=false
SOC2_MODE=false

# =============================================================================
# DEVELOPMENT AND TESTING
# =============================================================================

# Development Tools
HOT_RELOAD=true
WATCHPACK_POLLING=true
DEV_SERVER_HOST=0.0.0.0

# Testing Configuration
TEST_DATABASE_URL=postgres://skauswatch_test:test_password@localhost:5432/skauswatch_test
TEST_REDIS_URL=redis://localhost:6379/1

# =============================================================================
# PERFORMANCE AND SCALING
# =============================================================================

# Connection Pool Settings
DB_MAX_CONNECTIONS=100
DB_MIN_CONNECTIONS=10
DB_CONNECTION_TIMEOUT=30s

# Cache Settings
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=10

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log Settings
LOG_FORMAT=json
LOG_OUTPUT=stdout
LOG_FILE_PATH=./logs/application.log
LOG_FILE_MAX_SIZE=100MB
LOG_FILE_MAX_BACKUPS=5
LOG_FILE_MAX_AGE=30

# Component-specific log levels
MANAGER_LOG_LEVEL=info
PKI_SERVER_LOG_LEVEL=info
SSH_CA_LOG_LEVEL=info
AAA_MONITOR_LOG_LEVEL=info
WEB_PORTAL_LOG_LEVEL=info

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Feature Toggles
FEATURE_AUTO_RENEWAL=true
FEATURE_CERTIFICATE_TRANSPARENCY=true
FEATURE_OCSP_RESPONDER=true
FEATURE_CRL_DISTRIBUTION=true
FEATURE_KEY_ESCROW=false
FEATURE_MULTI_TENANCY=false

# =============================================================================
# ADVANCED CONFIGURATION
# =============================================================================

# Webhook Configuration
WEBHOOK_ENABLED=true
WEBHOOK_TIMEOUT=30s
WEBHOOK_RETRY_COUNT=3

# Certificate Validation
CERT_VALIDATION_STRICT=true
CERT_VALIDATION_CRL_CHECK=true
CERT_VALIDATION_OCSP_CHECK=true

# Key Management
KEY_ROTATION_ENABLED=true
KEY_ROTATION_INTERVAL=90d
KEY_BACKUP_ENABLED=true

# =============================================================================
# NOTES
# =============================================================================

# 1. Change all "changeme_" prefixed values before deployment
# 2. Use strong, unique passwords for all services
# 3. Consider using Docker secrets or external secret management in production
# 4. Review and adjust security settings based on your requirements
# 5. Enable HTTPS/TLS for all external communications in production
# 6. Configure proper firewall rules and network segmentation
# 7. Set up monitoring and alerting for all critical services
# 8. Implement proper backup and disaster recovery procedures