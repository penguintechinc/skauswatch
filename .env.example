# SkausWatch Environment Configuration
# Copy this file to .env and adjust values as needed

# =============================================================================
# ENVIRONMENT SETTINGS
# =============================================================================
ENVIRONMENT=development
VERSION=0.1.0

# Build arguments
BUILD_DATE=
VCS_REF=

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_DB=skauswatch
POSTGRES_USER=skauswatch
POSTGRES_PASSWORD=skauswatch_dev_password_change_in_production
POSTGRES_PORT=5432
DATABASE_HOST=postgres
DATABASE_PORT=5432

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_PASSWORD=redis_dev_password_change_in_production
REDIS_PORT=6379
REDIS_HOST=redis

# =============================================================================
# SERVICE PORTS
# =============================================================================
MANAGER_PORT=8000
PKI_PORT=8001
SSHCA_PORT=8002
MONITOR_PORT=8003

# Metrics ports
MANAGER_METRICS_PORT=9000
PKI_METRICS_PORT=9001
SSHCA_METRICS_PORT=9002
MONITOR_METRICS_PORT=9003

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
JWT_SECRET_KEY=dev_jwt_secret_key_change_in_production_to_long_random_string
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# =============================================================================
# CERTIFICATE SETTINGS
# =============================================================================
CA_CERT_VALIDITY_DAYS=3650
SERVER_CERT_VALIDITY_DAYS=365
SSH_CERT_VALIDITY_HOURS=24
SSH_HOST_CERT_VALIDITY_DAYS=365

# =============================================================================
# LOGGING AND MONITORING
# =============================================================================
LOG_LEVEL=INFO
MAX_LOG_RETENTION_DAYS=90
SYSLOG_PORT=514

# =============================================================================
# CODESCAN AI CODE REVIEW
# =============================================================================
# Dedicated DB account for CodeScan (see Phase 7 in CodeScan integration docs)
CODESCAN_DB_USER=codescan
CODESCAN_DB_PASS=change-me-codescan-pass

# AI provider selection (anthropic, openai, ollama)
CODESCAN_AI_PROVIDER=anthropic
CODESCAN_AI_MODEL=claude-opus-4-5

# AI provider API keys (only the selected provider is required)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_URL=http://ollama:11434

# Community free-tier caps (lifted by CodeScan license)
CODESCAN_FREE_TIER_USER_CAP=3
CODESCAN_MAX_REPOS_FREE=3
CODESCAN_MAX_REVIEWS_PER_DAY=10

# Port for the CodeScan worker API
WORKER_CODESCAN_PORT=5005

# License key — enables paid CodeScan features when set
LICENSE_KEY=

# =============================================================================
# CELERY SETTINGS
# =============================================================================
CELERY_WORKER_CONCURRENCY=4

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Set to :ro for production or leave empty for development
VOLUME_MOUNT_OPTIONS=

# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================
# Uncomment and modify these for production deployment

# Strong passwords for production
# POSTGRES_PASSWORD=your_strong_postgres_password_here
# REDIS_PASSWORD=your_strong_redis_password_here
# JWT_SECRET_KEY=your_jwt_secret_key_minimum_256_bits_entropy

# Production environment
# ENVIRONMENT=production
# LOG_LEVEL=WARNING
# VOLUME_MOUNT_OPTIONS=:ro

# External service endpoints for production
# DATABASE_HOST=your_postgres_host
# REDIS_HOST=your_redis_host

# Production CORS settings
# CORS_ORIGINS=https://your-frontend-domain.com
